// Attendance & HR system — UAE
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  EMPLOYEE
  BRANCH_MANAGER
  HR_ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum DeviceStatus {
  PENDING
  ACTIVE
  REVOKED
}

enum PunchType {
  CHECK_IN
  BREAK_START
  BREAK_END
  CHECK_OUT
}

enum PunchSource {
  APP
  KIOSK
  MANUAL
}

enum DayStatus {
  PRESENT
  LATE
  HALF_DAY
  ABSENT
  ON_LEAVE
  HOLIDAY
  WEEKLY_OFF
  MISSED_PUNCH
}

enum RequestStatus {
  PENDING_MANAGER
  PENDING_HR
  APPROVED
  REJECTED
  CANCELLED
}

enum DocumentType {
  EMIRATES_ID
  PASSPORT
  RESIDENCE_VISA
  LABOUR_CARD
  MEDICAL_INSURANCE
  DRIVING_LICENCE
  CONTRACT
  OTHER
}

enum Gender {
  MALE
  FEMALE
}

enum WorkMode {
  OFFICE
  FIELD
}

model Branch {
  id          String     @id @default(uuid())
  code        String     @unique
  name        String
  emirate     String
  address     String?
  latitude    Float
  longitude   Float
  radiusM     Int        @default(100)
  wifiBssids  String[]   @default([])
  active      Boolean    @default(true)
  createdAt   DateTime   @default(now())
  employees   Employee[]
  managers    User[]     @relation("ManagedBranches")
  holidays    Holiday[]
  attendance  AttendanceDay[]
}

model Department {
  id        String     @id @default(uuid())
  name      String     @unique
  employees Employee[]
}

model User {
  id               String         @id @default(uuid())
  employeeCode     String         @unique
  email            String         @unique
  phone            String?
  passwordHash     String
  role             Role           @default(EMPLOYEE)
  status           UserStatus     @default(ACTIVE)
  failedLogins     Int            @default(0)
  lockedUntil      DateTime?
  mustChangePwd    Boolean        @default(true)
  mfaSecret        String?
  mfaEnabled       Boolean        @default(false)
  lastLoginAt      DateTime?
  createdAt        DateTime       @default(now())
  employee         Employee?
  devices          Device[]
  refreshTokens    RefreshToken[]
  managedBranches  Branch[]       @relation("ManagedBranches")
  auditLogs        AuditLog[]
  approvals        Approval[]
  notifications    Notification[]
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  deviceId   String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model Device {
  id           String       @id @default(uuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId     String
  model        String?
  platform     String?
  pushToken    String?
  status       DeviceStatus @default(PENDING)
  registeredAt DateTime     @default(now())
  approvedAt   DateTime?

  @@unique([userId, deviceId])
}

model Shift {
  id            String     @id @default(uuid())
  name          String     @unique
  startTime     String     // "09:00" local time
  endTime       String     // "18:00"
  breakMinutes  Int        @default(60)
  graceMinutes  Int        @default(10)
  weeklyOffDays Int[]      @default([0]) // 0=Sunday ... 6=Saturday
  employees     Employee[]
}

model Employee {
  id              String        @id @default(uuid())
  userId          String        @unique
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  branchId        String
  branch          Branch        @relation(fields: [branchId], references: [id])
  departmentId    String?
  department      Department?   @relation(fields: [departmentId], references: [id])
  managerId       String?
  manager         Employee?     @relation("Reports", fields: [managerId], references: [id])
  reports         Employee[]    @relation("Reports")
  shiftId         String?
  shift           Shift?        @relation(fields: [shiftId], references: [id])
  firstName       String
  lastName        String
  nameArabic      String?
  designation     String
  gender          Gender
  dateOfBirth     DateTime?
  nationality     String
  maritalStatus   String?
  religion        String?
  bloodGroup      String?
  uaeAddress      String?
  emirate         String?
  homeAddress     String?
  emergencyName     String?
  emergencyRelation String?
  emergencyPhone    String?
  joiningDate     DateTime
  probationEnd    DateTime?
  contractType    String        @default("UNLIMITED")
  contractEnd     DateTime?
  workMode        WorkMode      @default(OFFICE)
  allowRemotePunch Boolean      @default(false)
  photoUrl        String?
  // Salary (HR only)
  basicSalary     Decimal?      @db.Decimal(12, 2)
  housingAllow    Decimal?      @db.Decimal(12, 2)
  transportAllow  Decimal?      @db.Decimal(12, 2)
  otherAllow      Decimal?      @db.Decimal(12, 2)
  iban            String?
  bankName        String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  documents       EmployeeDocument[]
  punches         Punch[]
  attendanceDays  AttendanceDay[]
  leaveBalances   LeaveBalance[]
  leaveRequests   LeaveRequest[]
  regularizations Regularization[]

  @@index([branchId])
}

model EmployeeDocument {
  id          String       @id @default(uuid())
  employeeId  String
  employee    Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type        DocumentType
  number      String?
  issueDate   DateTime?
  expiryDate  DateTime?
  fileUrl     String?
  notes       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([expiryDate])
}

model AttendanceDay {
  id              String     @id @default(uuid())
  employeeId      String
  employee        Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  branchId        String
  branch          Branch     @relation(fields: [branchId], references: [id])
  date            DateTime   @db.Date // company-local date
  firstIn         DateTime?
  lastOut         DateTime?
  workMinutes     Int        @default(0)
  breakMinutes    Int        @default(0)
  overtimeMinutes Int        @default(0)
  lateMinutes     Int        @default(0)
  earlyMinutes    Int        @default(0)
  status          DayStatus  @default(PRESENT)
  autoClosed      Boolean    @default(false)
  regularized     Boolean    @default(false)
  punches         Punch[]

  @@unique([employeeId, date])
  @@index([date])
}

model Punch {
  id              String        @id @default(uuid())
  employeeId      String
  employee        Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  attendanceDayId String
  attendanceDay   AttendanceDay @relation(fields: [attendanceDayId], references: [id], onDelete: Cascade)
  type            PunchType
  serverTime      DateTime      @default(now())
  deviceTime      DateTime?
  latitude        Float?
  longitude       Float?
  accuracyM       Float?
  distanceM       Float?
  insideGeofence  Boolean       @default(false)
  wifiBssid       String?
  selfieUrl       String?
  deviceId        String?
  source          PunchSource   @default(APP)
  isOffline       Boolean       @default(false)
  isRemote        Boolean       @default(false)
  flags           String[]      @default([])
  note            String?

  @@index([employeeId, serverTime])
}

model Regularization {
  id           String        @id @default(uuid())
  employeeId   String
  employee     Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date         DateTime      @db.Date
  checkIn      DateTime?
  checkOut     DateTime?
  reason       String
  status       RequestStatus @default(PENDING_MANAGER)
  createdAt    DateTime      @default(now())
}

model LeaveType {
  id                  String   @id @default(uuid())
  code                String   @unique
  name                String
  description         String?
  yearlyDays          Float    // entitlement per leave year (0 = unlimited / as approved)
  accrualMonthly      Boolean  @default(false)
  countsCalendarDays  Boolean  @default(true) // true: weekends/holidays inside range are counted
  paySlabs            Json?    // e.g. [{"days":15,"pay":"FULL"},{"days":30,"pay":"HALF"},{"days":45,"pay":"UNPAID"}]
  attachmentAfterDays Float?   // attachment required when request > N days (0 = always)
  minServiceMonths    Int      @default(0)
  requiresProbationDone Boolean @default(false)
  genderRule          Gender?
  carryForwardMax     Float    @default(0)
  allowHalfDay        Boolean  @default(true)
  paid                Boolean  @default(true)
  active              Boolean  @default(true)
  sortOrder           Int      @default(0)
  balances            LeaveBalance[]
  requests            LeaveRequest[]
}

model LeaveBalance {
  id             String    @id @default(uuid())
  employeeId     String
  employee       Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId    String
  leaveType      LeaveType @relation(fields: [leaveTypeId], references: [id])
  year           Int
  entitled       Float     @default(0)
  carriedForward Float     @default(0)
  adjustment     Float     @default(0)
  taken          Float     @default(0)
  pending        Float     @default(0)

  @@unique([employeeId, leaveTypeId, year])
}

model LeaveRequest {
  id            String        @id @default(uuid())
  employeeId    String
  employee      Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId   String
  leaveType     LeaveType     @relation(fields: [leaveTypeId], references: [id])
  fromDate      DateTime      @db.Date
  toDate        DateTime      @db.Date
  halfDay       String?       // null | "FIRST_HALF" | "SECOND_HALF"
  days          Float
  reason        String
  attachmentUrl String?
  status        RequestStatus @default(PENDING_MANAGER)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([employeeId, fromDate])
  @@index([status])
}

model Approval {
  id          String   @id @default(uuid())
  entityType  String   // "LEAVE" | "REGULARIZATION" | "DEVICE"
  entityId    String
  level       String   // "MANAGER" | "HR"
  approverId  String
  approver    User     @relation(fields: [approverId], references: [id])
  action      String   // "APPROVED" | "REJECTED"
  comment     String?
  actedAt     DateTime @default(now())

  @@index([entityType, entityId])
}

model Holiday {
  id       String   @id @default(uuid())
  date     DateTime @db.Date
  name     String
  branchId String?
  branch   Branch?  @relation(fields: [branchId], references: [id])

  @@unique([date, name])
}

model Announcement {
  id        String   @id @default(uuid())
  title     String
  body      String
  branchId  String?
  createdBy String
  createdAt DateTime @default(now())
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

// Append-only audit trail. Never updated or deleted by the application.
model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
  action    String
  entity    String
  entityId  String?
  oldValue  Json?
  newValue  Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}
