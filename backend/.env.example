DATABASE_URL="postgresql://hrms:hrms_dev_pw@localhost:5432/hrms?schema=public"
# Generate strong secrets: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_DAYS=30
PORT=4000
# Comma-separated list of allowed web origins (admin portal)
CORS_ORIGINS="http://localhost:3000"
UPLOAD_DIR="./uploads"
# Company timezone (UAE has no DST: UTC+4)
TZ_OFFSET_MINUTES=240
